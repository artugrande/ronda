# Copiá a .env.local y completá con tu deploy.
#
#   cp .env.example .env.local

# testnet | mainnet
NEXT_PUBLIC_RED=testnet

# Contract id que devuelve scripts/deploy.sh
NEXT_PUBLIC_CONTRATO=

# Qué ronda muestra la app. Un mismo deploy soporta varias.
NEXT_PUBLIC_RONDA_ID=0

# Opcional: sobreescribe el RPC por defecto de la red elegida.
# NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org


# ---------------------------------------------------------------------------
# Solo para el indexer (npm run indexer). NO llevan NEXT_PUBLIC_: la key del
# oráculo no puede terminar en el bundle del browser.
# ---------------------------------------------------------------------------

RPC_URL=https://soroban-testnet.stellar.org
PASSPHRASE=Test SDF Network ; September 2015
CONTRATO=
RONDA_ID=0

# La SAC que recibe los aportes. USDC en testnet, USDT0 en mainnet.
TOKEN=

# Key del oráculo (S...). Arrancá con SOLO_MIRAR=1 antes de dársela.
ORACULO_SECRET=
