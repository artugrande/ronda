# Copiá a .env.local y completá con tu deploy.
#
#   cp .env.example .env.local

# testnet | mainnet
NEXT_PUBLIC_RED=testnet

# Opcional: sobreescribe el RPC por defecto de la red elegida.
# NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# ---------------------------------------------------------------------------
# Pozo (ahorro premiado). Lo imprime scripts/ensayo-pozo-testnet.sh.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POZO=

# ---------------------------------------------------------------------------
# Keeper del pozo (npm run keeper). Cierra rondas vencidas y trae la firma de
# drand. Es permissionless: KEEPER_SECRET es cualquier cuenta con XLM para
# fees. Arrancá con SOLO_MIRAR=1 y mirá qué haría antes de darle una key.
# NO lleva NEXT_PUBLIC_: nunca al bundle del browser.
# ---------------------------------------------------------------------------
RPC_URL=https://soroban-testnet.stellar.org
PASSPHRASE=Test SDF Network ; September 2015
POZO=
KEEPER_SECRET=

# ---------------------------------------------------------------------------
# Ronda rotativa (contrato `ronda`, el primer producto). Solo si la usás.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTRATO=
NEXT_PUBLIC_RONDA_ID=0
CONTRATO=
RONDA_ID=0
TOKEN=
ORACULO_SECRET=
